# Reference TLS terminator for the opt-in `protected` compose profile.
# One hostname from WAVEKIT_PUBLIC_HOST. Three HTTPS origins, each proxied to a
# loopback HTTP listener in this network namespace. reverse_proxy forwards
# WebSocket upgrades (Connection and Upgrade) unchanged.
# Local CA: tls internal. The data directory is CA key material.
# export-trust.sh publishes only root.crt on the trust volume.
{
	admin off
	skip_install_trust
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

https://{$WAVEKIT_PUBLIC_HOST}:9443 {
	bind 0.0.0.0
	tls internal
	reverse_proxy 127.0.0.1:9000 {
		header_up Host {http.request.hostport}
		flush_interval -1
	}
}

https://{$WAVEKIT_PUBLIC_HOST}:9444 {
	bind 0.0.0.0
	tls internal
	reverse_proxy 127.0.0.1:8081 {
		header_up Host {http.request.hostport}
		flush_interval -1
	}
}

https://{$WAVEKIT_PUBLIC_HOST}:9445 {
	bind 0.0.0.0
	tls internal
	reverse_proxy 127.0.0.1:8082 {
		header_up Host {http.request.hostport}
		flush_interval -1
	}
}

# Optional web app origin (example, disabled). The web app is supported on its
# own port of the API hostname only (same scheme and host, so same site: the
# host-only SameSite=Strict session cookie is sent). Another hostname or site is
# unsupported by design. To enable: uncomment, publish 9446, serve the built web
# app from the root below, and add "https://<host>:9446" to
# access.allowedOrigins (see protected-runtime.yaml). The web app calls the API
# origin (9443) with credentials: "include"; no proxy to the API is needed here.
# https://{$WAVEKIT_PUBLIC_HOST}:9446 {
# 	bind 0.0.0.0
# 	tls internal
# 	root * /srv/wavekit-web
# 	try_files {path} /index.html
# 	file_server
# }
