+size_t Command::configuredBufferSize() {
+    const char* setting = std::getenv("WAVEKIT_CSDR_BUFFER_ELEMENTS");
+    if (setting == nullptr) return bufferSize();
+
+    const std::string name = "WAVEKIT_CSDR_BUFFER_ELEMENTS";
+    constexpr size_t maximum = 10485760;
+    size_t value = 0;
+    if (*setting == '\0') throw CLI::ValidationError(name, "must be a decimal integer");
+    for (const char* p = setting; *p; ++p) {
+        if (*p < '0' || *p > '9' || value > (maximum - (*p - '0')) / 10) {
+            throw CLI::ValidationError(name, "must be a decimal integer from 2048 to 10485760");
+        }
+        value = value * 10 + (*p - '0');
+    }
+    if (value < 2048 || value > maximum) {
+        throw CLI::ValidationError(name, "must be from 2048 to 10485760 elements");
+    }
+    if (*get_parent()->get_option("--async")) {
+        throw CLI::ValidationError(name, "only supports synchronous processing; remove --async");
+    }
+    const size_t minimum = minimumBufferSize();
+    if (value < minimum) {
+        throw CLI::ValidationError(name, "requires at least " + std::to_string(minimum) +
+                                   " elements for this command's lookahead and 1024-element read");
+    }
+    return value;
+}
