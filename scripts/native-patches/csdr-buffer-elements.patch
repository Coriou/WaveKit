+size_t FirDecimateCommand::minimumBufferSize() {
+    if (decimationFactor == 0 || !std::isfinite(transitionBandwidth) || transitionBandwidth <= 0) {
+        throw CLI::ValidationError("WAVEKIT_CSDR_BUFFER_ELEMENTS",
+                                   "firdecimate requires positive decimation and finite positive transition bandwidth");
+    }
+    // FirFilter::filterLength uses floor(4 / transition), rounded up to odd.
+    // Conservatively allow an extra tap, the largest residual decimation
+    // window, one unchanged read batch, and the ring's empty-slot sentinel.
+    const double lookahead = std::ceil(4.0 / transitionBandwidth) + 1;
+    if (lookahead > 10485760 || decimationFactor > 10485760) {
+        throw CLI::ValidationError("WAVEKIT_CSDR_BUFFER_ELEMENTS", "firdecimate lookahead exceeds the opt-in buffer limit");
+    }
+    return static_cast<size_t>(lookahead) + decimationFactor + 1024;
+}
