{
	"name": "@wavekit/brand",
	"version": "1.0.0",
	"private": true,
	"description": "WaveKit brand kit: logos, marks, icons, tokens, fonts and React components",
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"exports": {
		"./tokens/brand.css": "./tokens/brand.css",
		"./tokens/typography.css": "./tokens/typography.css",
		"./tokens/tokens.json": "./tokens/tokens.json",
		"./brand.config.json": "./brand.config.json",
		"./icons/categories.json": "./icons/categories.json",
		"./logos/*": "./logos/*",
		"./marks/*": "./marks/*",
		"./icons/*": "./icons/*",
		"./artwork/*": "./artwork/*",
		"./exports/*": "./exports/*",
		"./templates/*": "./templates/*",
		"./fonts/*": "./fonts/*",
		"./react": {
			"types": "./react/index.ts",
			"default": "./react/index.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"typecheck": "pnpm -w exec tsc -p packages/brand/tsconfig.json --noEmit",
		"lint": "eslint -c ../../eslint.config.js .",
		"test": "vitest run --passWithNoTests",
		"validate": "python3 -I source/validate.py",
		"validate:render": "python3 -I source/validate.py --render"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/react": "^18.3.18",
		"react": "^18.3.1",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
