{
	"schemaVersion": 2,
	"format": "Plain JSON design tokens. Mirrors tokens/brand.css and tokens/typography.css; source/validate.py checks they agree.",
	"colors": {
		"ink": "#111C19",
		"phosphor": "#7BECC7",
		"paper": "#F4F7F5",
		"forest": "#16735C",
		"muted": "#52645D",
		"rule": "#E4ECE7"
	},
	"themes": {
		"light": {
			"bg": "#F4F7F5",
			"surface": "#FFFFFF",
			"fg": "#111C19",
			"fgMuted": "#52645D",
			"accent": "#16735C",
			"accentInk": "#FFFFFF",
			"borderDecorative": "#E4ECE7",
			"borderControl": "#52645D",
			"focusRing": "#16735C"
		},
		"dark": {
			"bg": "#111C19",
			"surface": "#192B24",
			"fg": "#F4F7F5",
			"fgMuted": "#B9CAC1",
			"accent": "#7BECC7",
			"accentInk": "#111C19",
			"borderDecorative": "#2C443B",
			"borderControl": "#8BA598",
			"focusRing": "#7BECC7"
		}
	},
	"notYetDefinedByBrand": ["success", "warning", "error", "info"],
