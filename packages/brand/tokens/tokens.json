	},
	"targetMinPx": 44,
	"type": {
		"display": "D-DIN Condensed",
		"body": "Noto Sans",
		"bodyRem": 1.125,
		"bodyLineHeight": 1.62,
		"bodyMeasureCh": 64,
		"largeBodyRem": 1.375,
		"largeBodyLineHeight": 1.56,
		"uiRem": 1,
		"uiLineHeight": 1.45,
		"captionRem": 0.875,
		"fonts": {
			"D-DIN Condensed": {
				"400": "fonts/d-din/D-DINCondensed.woff2",
				"700": "fonts/d-din/D-DINCondensed-Bold.woff2"
			},
			"Noto Sans": {
				"400": "fonts/noto-sans/NotoSans-Regular.woff2",
				"700": "fonts/noto-sans/NotoSans-Bold.woff2",
				"400italic": "fonts/noto-sans/NotoSans-Italic.woff2"
			}
		}
	},
	"icon": {
		"viewBox": [0, 0, 24, 24],
		"strokeWidth": 2
	}
}
