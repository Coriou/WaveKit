{
	"$comment": "Which documentation page describes which code. scripts/check-docs.mjs fails when code changes without its page, unless each commit that touched it carries a 'Docs: none' or 'Docs: <page>' trailer. Paths are prefixes from the repository root; a file belongs to the entry with the longest matching prefix, and any one page of that entry satisfies it. tests/unit/repo/doc-map-coverage.test.ts fails when a code area has no entry.",
	"entries": [
		{
			"code": [
				"web/src/features/",
				"web/src/shell/",
				"web/src/spectrum/",
				"web/src/pwa/",
				"web/src/plot/",
				"web/src/data/"
			],
			"docs": ["docs/WEB-APP.md"]
		},
		{ "code": ["web/mock/"], "docs": ["web/mock/README.md"] },
		{
			"code": ["src/api/", "src/operator-data/", "packages/api-types/"],
			"docs": ["docs/API.md"]
		},
		{
			"code": ["src/config.ts", "config/default.yaml"],
			"docs": ["docs/CORE-REFERENCE.md", "docs/DOCKER-RUNTIME.md"]
		},
		{
			"code": ["src/decoders/"],
			"docs": ["readme.md", "docs/DECODER-GUIDE.md"]
		},
		{
			"code": ["src/access/", "src/access-command.ts"],
			"docs": ["docs/DOCKER-SETUP.md", "docs/LOCAL-SETUP.md"]
		},
		{
			"code": [
				"src/core/scanner/",
				"src/core/spectrum/",
				"src/core/bandplans/",
				"src/core/bandplan-url/",
				"src/core/auto-listen/",
				"src/core/audio-tones/",
